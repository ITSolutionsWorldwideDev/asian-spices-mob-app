# EAS Build ignore — replaces .gitignore for uploads (must include all .gitignore rules too)

# Git metadata (~600MB if included)
.git
.git/
**/.git
**/.git/

# Monorepo: exclude API app entirely (backend is on Vercel)
/apps/api
apps/api
apps/api/
apps/api/**
**/apps/api
**/apps/api/

# Dependencies (EAS installs these on the build server)
/node_modules
node_modules/
**/node_modules/
apps/*/node_modules/
packages/*/node_modules/

# Build / cache
.next/
**/.next/
apps/api/.next/
.expo/
**/.expo/
apps/mobile/.expo/
apps/mobile/.metro-health-check*
dist/
web-build/
*.tsbuildinfo

# Git / tooling
.cursor/
agent-transcripts/
.claude/
.vscode/
*.md
!apps/mobile/README.md

# Env / secrets
.env
.env.*
.env*.local
**/.env
**/.env.*
apps/mobile/.env
apps/api/.env

# Native / OS
.kotlin/
/ios
/android
ios/
android/
.DS_Store
*.orig.*
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*

# Large media that must not ship in the mobile upload
**/*.mp4
**/*.mov
**/*.avi
**/*.mkv
**/*.webm
