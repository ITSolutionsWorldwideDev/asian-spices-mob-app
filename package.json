{
  "name": "asian-spices-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run api:dev",
    "build": "npm run api:build",
    "web": "npm run mobile:web",
    "start": "npm run mobile:start",
    "mobile:start": "npm run start -w @asian-spices/mobile",
    "mobile:android": "npm run android -w @asian-spices/mobile",
    "mobile:ios": "npm run ios -w @asian-spices/mobile",
    "mobile:web": "npm run web -w @asian-spices/mobile",
    "mobile:lint": "npm run lint -w @asian-spices/mobile",
    "api:dev": "npm run dev -w @asian-spices/api",
    "api:build": "npm run build -w @asian-spices/api",
    "api:start": "npm run start -w @asian-spices/api",
    "api:db:generate": "npm run db:generate -w @asian-spices/api",
    "api:db:push": "npm run db:push -w @asian-spices/api",
    "api:db:pull": "npm run db:pull -w @asian-spices/api"
  },
  "dependencies": {
    "next-auth": "^4.24.14"
  }
}
